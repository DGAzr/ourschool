# Stage 1: build the React app
# The output is static JS/CSS, shared by every target architecture. Build it
# natively so npm's build tools don't run under QEMU during multi-platform builds.
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder

# Version string available to the frontend build. The publish workflow passes
# the release tag; local builds default to "dev" unless APP_VERSION is set.
ARG APP_VERSION=dev

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
ENV VITE_APP_VERSION=${APP_VERSION}
RUN npm run build

# Stage 2: serve with nginx
FROM nginx:alpine AS runner

# Remove the default config and install ours
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/ourschool.conf

# Copy built assets from Stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
